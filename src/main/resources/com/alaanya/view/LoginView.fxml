<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import java.net.URL?>
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="controller.LoginController"
          styleClass="login-grid">
    <stylesheets>
        <URL value="@css/style.css"/>
    </stylesheets>

    <Label text="TELEPHONE :" styleClass="login-label"
           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <TextField fx:id="militaryIdField" styleClass="login-text-field"
               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="Mot de Passe:" styleClass="login-label"
           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <PasswordField fx:id="passwordField" styleClass="login-text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Button text="Connexion" onAction="#handleLogin" styleClass="login-button"
            GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <HBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
        <Label text="Nouvel utilisateur ?" styleClass="login-label"/>
        <Hyperlink text="Créer un compte" onAction="#loadRegisterView" styleClass="create-account-link"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="login-error-message"
           GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2"/>

</GridPane>
