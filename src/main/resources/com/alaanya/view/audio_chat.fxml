<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.AudioChatController"
           stylesheets="@../../../css/audio-chat.css">

    <!-- Fond avec dégradé similaire à WhatsApp -->
    <VBox fx:id="audioChatVBox" alignment="CENTER" spacing="40"
          styleClass="audio-chat-container">
        
        <!-- Photo de profil (cercle) -->
        <StackPane styleClass="profile-container">
            <Circle radius="80" styleClass="profile-circle"/>
            <FontIcon iconLiteral="fas-user" iconSize="50" styleClass="profile-icon"/>
        </StackPane>

        <!-- Informations d'appel -->
        <VBox alignment="CENTER" spacing="10">
            <!-- Nom de l'appelant -->
            <Label fx:id="callerLabel" text="Capitaine X" 
                   styleClass="caller-label"/>
            
            <!-- Statut/Durée de l'appel -->
            <Label fx:id="callDurationLabel" text="Appel en cours - 00:00" 
                   styleClass="duration-label"/>
        </VBox>

        <!-- Boutons de contrôle -->
        <HBox alignment="CENTER" spacing="30" styleClass="control-buttons">
            <Button styleClass="control-button" tooltip="Microphone">
                <graphic>
                    <FontIcon iconLiteral="fas-microphone" iconSize="20"/>
                </graphic>
            </Button>
            
            <Button styleClass="control-button" tooltip="Haut-parleur">
                <graphic>
                    <FontIcon iconLiteral="fas-volume-up" iconSize="20"/>
                </graphic>
            </Button>
            
            <Button fx:id="endCallButton" styleClass="end-call-button" tooltip="Raccrocher">
                <graphic>
                    <FontIcon iconLiteral="fas-phone-slash" iconSize="24"/>
                </graphic>
            </Button>
            
            <Button styleClass="control-button" tooltip="Clavier">
                <graphic>
                    <FontIcon iconLiteral="fas-keyboard" iconSize="20"/>
                </graphic>
            </Button>
            
            <Button styleClass="control-button" tooltip="Ajouter un appel">
                <graphic>
                    <FontIcon iconLiteral="fas-user-plus" iconSize="20"/>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</StackPane>