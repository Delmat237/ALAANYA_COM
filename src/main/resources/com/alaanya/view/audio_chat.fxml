<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<VBox fx:controller="controller.AudioChatController"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER" spacing="15" style="-fx-padding: 20;">
    <Label fx:id="callDurationLabel" text="Durée : 00:00" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Button fx:id="endCallButton" text="Raccrocher" style="-fx-background-color: red; -fx-text-fill: white;"/>
</VBox>
