<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:controller="controller.AudioChatController"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="15"
      style="-fx-padding: 20;">

    <!-- Affichage de la durée de l'appel -->
    <Label fx:id="callDurationLabel"
           text="Durée : 00:00"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Bouton de fin d'appel avec icône -->
    <Button fx:id="endCallButton"
            text="Raccrocher"
            style="-fx-background-color: red; -fx-text-fill: white;">
        <graphic>
            <FontIcon iconLiteral="fas-phone-slash" iconSize="16" iconColor="white"/>
        </graphic>
    </Button>

</VBox>
