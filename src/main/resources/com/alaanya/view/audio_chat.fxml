<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:controller="controller.AudioChatController"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="25"
      style="-fx-padding: 40; -fx-background-color: linear-gradient(to bottom, #f2f2f2, #d9d9d9);"
>

    <!-- Titre ou nom de l'appelant (optionnel) -->
    <Label fx:id="callerLabel"
           text="Appel avec Capitaine X"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Affichage de la durée de l'appel -->
    <Label fx:id="callDurationLabel"
           text="Durée : 00:00"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />

    <!-- Bouton de fin d'appel avec icône -->
    <Button fx:id="endCallButton"
            text="  Raccrocher"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20 10 20; -fx-cursor: hand;">
        <graphic>
            <FontIcon iconLiteral="fas-phone-slash" iconSize="18" iconColor="white"/>
        </graphic>
    </Button>

</VBox>
