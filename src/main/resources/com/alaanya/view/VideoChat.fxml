<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="controller.VideoChatController"
            style="-fx-background-color: linear-gradient(to bottom, #f0f2f5, #d6e0ea);">

    <!-- Conteneur principal -->
    <VBox alignment="CENTER" spacing="20" layoutX="0" layoutY="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <padding>
            <Insets top="30" bottom="30" left="30" right="30"/>
        </padding>
        <!-- Titre ou nom de l'appelant (optionnel) -->
        <Label fx:id="callerLabel"
               text="Appel avec Capitaine X"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <!-- Conteneur pour les vues vidéo -->
        <HBox alignment="CENTER" spacing="30">
            <!-- Vue locale de la vidéo -->
            <ImageView fx:id="localView"
                       fitWidth="300" fitHeight="220"
                       style="-fx-border-color: #2c3e50; -fx-border-width: 2; -fx-border-radius: 10;" />

            <!-- Vue distante de la vidéo -->
            <ImageView fx:id="remoteView"
                       fitWidth="300" fitHeight="220"
                       style="-fx-border-color: #2c3e50; -fx-border-width: 2; -fx-border-radius: 10;" />
        </HBox>

        <!-- Label pour afficher la durée de l'appel -->
        <Label fx:id="callDurationLabel"
               text="Durée : 00:00"
               visible="true"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />

        <!-- Bouton pour raccrocher l'appel -->
        <Button fx:id="endCallButton"
                text="  Raccrocher"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 20; -fx-cursor: hand;">
            <graphic>
                <FontIcon iconLiteral="fas-video-slash" iconSize="18" iconColor="white"/>
            </graphic>
        </Button>
    </VBox>
</AnchorPane>
