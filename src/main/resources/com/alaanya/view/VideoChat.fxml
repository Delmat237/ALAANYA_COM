<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>


<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.VideoChatController">
    <VBox spacing="10" alignment="CENTER">
        <Label text="Appel Vidéo" />
        <Label fx:id="callDurationLabel" text="Durée : 00:00" style="-fx-font-size: 14px;" />
        <HBox spacing="10">
            <ImageView fx:id="localView" fitWidth="320" fitHeight="240" />
            <ImageView fx:id="remoteView" fitWidth="320" fitHeight="240" />
        </HBox>
        <Button fx:id="startCallBtn" text="Démarrer Appel" onAction="#startCall" />
        <Button fx:id="startReceiveBtn" text="Accepter Appel" onAction="#startReceive" />
        <Button fx:id="hangUpBtn" text="Raccrocher" onAction="#hangUp" />
    </VBox>
</AnchorPane>
