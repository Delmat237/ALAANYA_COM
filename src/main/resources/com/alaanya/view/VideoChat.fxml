<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.VideoChatController"
            stylesheets="@../../../css/video-chat.css"
            styleClass="video-chat-root">

    <!-- Conteneur principal -->
    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          styleClass="video-chat-container">
        <padding>
            <Insets top="30" bottom="30" left="30" right="30"/>
        </padding>

        <!-- Titre ou nom de l'appelant -->
        <Label fx:id="callerLabel"
               text="Appel avec Capitaine X"
               styleClass="caller-label"/>

        <!-- Vues vidéo -->
        <HBox alignment="CENTER" spacing="30">
            <ImageView fx:id="localView"
                       fitWidth="300" fitHeight="220"
                       styleClass="video-view"/>
            <ImageView fx:id="remoteView"
                       fitWidth="300" fitHeight="220"
                       styleClass="video-view"/>
        </HBox>

        <!-- Durée de l'appel -->
        <Label fx:id="callDurationLabel"
               text="Durée : 00:00"
               visible="true"
               styleClass="duration-label"/>

        <!-- Bouton de fin d'appel -->
        <Button fx:id="endCallButton"
                text="  Raccrocher"
                styleClass="end-call-button">
            <graphic>
                <FontIcon iconLiteral="fas-video-slash" iconSize="18" iconColor="white"/>
            </graphic>
        </Button>
    </VBox>
</AnchorPane>
