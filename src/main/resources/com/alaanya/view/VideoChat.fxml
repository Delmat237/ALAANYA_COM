<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.VideoChatController"
            stylesheets="@../../../css/video-chat.css"
            styleClass="video-chat-root">

    <!-- Conteneur principal -->
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <!-- Vue distante (plein écran) -->
        <ImageView fx:id="remoteView" fitWidth="100%" fitHeight="100%" 
                   preserveRatio="true" styleClass="remote-video-view"/>
        
        <!-- Overlay avec informations et contrôles -->
        <VBox alignment="CENTER" spacing="20" styleClass="video-overlay">
            <padding>
                <Insets top="50" bottom="50" left="30" right="30"/>
            </padding>
            
            <!-- Vue locale (petite fenêtre) -->
            <StackPane alignment="TOP_RIGHT" styleClass="local-video-container">
                <ImageView fx:id="localView" fitWidth="120" fitHeight="160" 
                           styleClass="local-video-view"/>
            </StackPane>
            
            <!-- Nom de l'appelant -->
            <Label fx:id="callerLabel" text="Capitaine X" 
                   styleClass="caller-label"/>
            
            <!-- Statut/Durée de l'appel -->
            <Label fx:id="callDurationLabel" text="Appel en cours - 00:00" 
                   styleClass="duration-label"/>
            
            <!-- Boutons de contrôle -->
            <HBox alignment="CENTER" spacing="30" styleClass="control-buttons">
                <Button styleClass="control-button" tooltip="Microphone">
                    <graphic>
                        <FontIcon iconLiteral="fas-microphone" iconSize="20"/>
                    </graphic>
                </Button>
                
                <Button styleClass="control-button" tooltip="Haut-parleur">
                    <graphic>
                        <FontIcon iconLiteral="fas-volume-up" iconSize="20"/>
                    </graphic>
                </Button>
                
                <Button fx:id="endCallButton" styleClass="end-call-button" tooltip="Raccrocher">
                    <graphic>
                        <FontIcon iconLiteral="fas-phone-slash" iconSize="20"/>
                    </graphic>
                </Button>
                
                <Button styleClass="control-button" tooltip="Retourner la caméra">
                    <graphic>
                        <FontIcon iconLiteral="fas-sync-alt" iconSize="20"/>
                    </graphic>
                </Button>
                
                <Button styleClass="control-button" tooltip="Activer/désactiver la vidéo">
                    <graphic>
                        <FontIcon iconLiteral="fas-video" iconSize="20"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>