<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.VideoChatController">

    <!-- Conteneur principal -->
    <VBox alignment="CENTER" spacing="15">
        <padding>
            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
        </padding>

        <!-- Conteneur pour les vues vidéo -->
        <HBox alignment="CENTER" spacing="10" >
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <!-- Vue locale de la vidéo -->
            <ImageView fx:id="localView" fitWidth="320" fitHeight="240" style="-fx-border-color: black;" />
            <!-- Vue distante de la vidéo -->
            <ImageView fx:id="remoteView" fitWidth="320" fitHeight="240" style="-fx-border-color: black;" />
        </HBox>

        <!-- Label pour afficher la durée de l'appel -->
        <Label fx:id="callDurationLabel" text="Durée : 00:00" style="-fx-font-size: 18px; -fx-font-weight: bold;" visible="false" />

        <!-- Bouton pour raccrocher l'appel -->
        <Button fx:id="endCallButton" text="Raccrocher" style="-fx-background-color: red; -fx-text-fill: white;" onAction="#hangUp" />
        <padding>
            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
        </padding>

    </VBox>

</AnchorPane>
